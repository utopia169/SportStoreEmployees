<Window x:Class="SportStoreEmployees.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportStoreEmployees"
        mc:Ignorable="d"
        Title="Авторизация" Height="450" Width="400"
        Background="green">
    <Grid>
        <Border 
            Background="White"
            CornerRadius="10"
            Margin="20">

            <StackPanel 
                Margin="15">
                <Border 
                    BorderThickness="2"
                    BorderBrush="Black">

                    <TextBlock
                    Text="Sport Store App Employees"
                    Margin="0,2,0,2"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    />
                    <Border.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Border.Resources>
                </Border>
                <TextBlock
                    Text="Авторизация"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="Green"
                    Margin="0,25,0,0"/>

                <TextBlock 
                    Margin="0,25,0,0"
                    Width="250"
                    Height="20"
                    Text="Логин"
                    FontFamily="Segoe UI Semibold"
                    FontSize="12"/>
                <TextBox
                    x:Name="txtLogin"
                    Width="250"
                    Height="30"
                    BorderThickness="1"
                    BorderBrush="Black"
                    VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock
                    Margin="0,20,0,0"
                    Text="Пароль"
                    Width="250"
                    Height="20"
                    FontFamily="Segoe UI Semibold"
                    FontSize="12"
                    />
                <TextBox
                    x:Name="txtPassword"
                    Width="250"
                    Height="30"
                    BorderThickness="1"
                    BorderBrush="Black"
                    VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock 
                    Text="Забыли пароль?"
                    Width="250"
                    Height="20"
                    FontSize="12"
                    FontFamily="Segoe UI Semibold"
                    Margin="0,2,0,10"
                    Cursor="Hand"
                    Foreground="Blue"/>
                <TextBlock
                    Text="Неправильный логин или пароль!"
                    Width="250"
                    Height="20"
                    FontSize="12"
                    FontFamily="Segoe UI Semibold"
                    Margin="0,2,0,10"
                    Foreground="Red"
                    IsVisibleChanged="TextBlock_IsVisibleChanged"
                    Visibility="Hidden"
                    x:Name="LoginEror"/>

                <Button 
                        Content="Войти в систему"
                        VerticalContentAlignment="Center"
                        Margin="10,35,20,0"
                        Width="200"
                        Height="30"
                        BorderThickness="1"
                        FontSize="14"
                        BorderBrush="Black"
                        Background="Transparent"
                        Cursor="Hand" 
                        Click="ButnLogin_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <TextBox 
                    Text="Забыли пароль?"
                    HorizontalContentAlignment="Center"
                    Margin="0,20,0,0"
                    Foreground="#737578"
                    BorderBrush="Transparent"
                    FontSize="12"
                    Cursor="Hand">
                </TextBox>
            </StackPanel>
        </Border>
    </Grid>

</Window>
