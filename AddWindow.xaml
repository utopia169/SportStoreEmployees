<Window x:Class="SportStoreEmployees.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportStoreEmployees"
        mc:Ignorable="d"
        Title="Добавление персонала" Height="450" Width="400" Background="Green">
    <Grid Margin="10" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition  Height="40"></RowDefinition>
            <RowDefinition ></RowDefinition>
            <RowDefinition  Height="50"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Добавление персонала"
                FontSize="18"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>
        </Grid>
        
        <!--1-->

        <StackPanel 
            Grid.Row="1"
            Margin="60,0">

            <TextBlock
                Margin="0,25,0,0"
                Text="Фамилия"
                FontSize="14"
                FontWeight="SemiBold"/>
            <TextBox
                Text=""
                Margin="0,5,0,0"
                FontSize="14"
                FontWeight="SemiBold"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Left"
                x:Name="txtLastName"/>

            <TextBlock
                Margin="0,10,0,0"
                Text="Имя"
                FontSize="14"
                FontWeight="SemiBold"/>
            <TextBox
                Text=""
                Margin="0,5,0,0"
                FontSize="14"
                FontWeight="SemiBold"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Left"
                x:Name="txtFirstName"/>


            <TextBlock
                Margin="0,10,0,0"
                Text="Должность"
                FontSize="14"
                FontWeight="SemiBold"/>

            <ComboBox
                Height="25"
                FontSize="14"
                x:Name="cmbRole"
                Background="White">
                <ComboBoxItem Content="Admin" FontSize="17" Height="25"/>
                <ComboBoxItem Content="Admin1" FontSize="17" Height="25"/>
                <ComboBoxItem Content="Admin2" FontSize="17" Height="25"/>
            </ComboBox>

            <TextBlock
                Margin="0,10,0,0"
                Text="Номер телефона"
                FontSize="14"
                FontWeight="SemiBold"/>
            <TextBox
                Text=""
                Margin="0,5,0,0"
                FontSize="14"
                FontWeight="SemiBold"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Left"
                x:Name="txtPhone"/>

            <TextBlock
                Margin="0,10,0,0"
                Text="Эллектронная почта"
                FontSize="14"
                FontWeight="SemiBold"/>
            <TextBox
                Text=""
                Margin="0,5,0,0"
                FontSize="14"
                FontWeight="SemiBold"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Left"
                x:Name="txtEmail"/>


        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center">

            <Button
                Height="38"
                Width="125"
                Background="Red"
                Foreground="White"
                BorderBrush="Gray"
                BorderThickness="1"
                Content="Отменить"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="20,0,0,5" 
                Click="ButnCancel_Click">

                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
                
            </Button>

            <Button
                Height="38"
                Width="125"
                Background="Green"
                Foreground="White"
                BorderBrush="Gray"
                BorderThickness="1"
                Content="Добавить"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="40,0,20,5" 
                Click="Butn_AddClick">

                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>


        </StackPanel>
    </Grid>
</Window>
